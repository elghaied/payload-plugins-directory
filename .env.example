# Postgres (docker-compose.dev.yml exposes 5433)
DATABASE_URL=postgresql://directory:directory@localhost:5433/directory
DATABASE_URL_TEST=postgresql://directory:directory@localhost:5433/directory_test
# openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public origin, read at runtime by Payload (serverURL → allowed origins) and robots/noindex.
# Set it in every deployed environment; NEXT_PUBLIC_SITE_URL is only a local-dev fallback.
SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GitHub API token for the sync worker (pnpm worker / the `worker` container); public read access is enough.
GITHUB_TOKEN=
# Optional, web service only: a fine-grained PAT with "Public repositories (read-only)" access and no other permissions,
# ideally on a bot account that belongs to no orgs. Lifts claim ownership checks from 60 to 5,000 requests/hour.
# Never reuse the worker's GITHUB_TOKEN here (the web client deliberately ignores it).
GITHUB_WEB_TOKEN=
# db:pull / db:push (Task 11). db:push requires the db, web and worker containers (the worker is stopped
# during the restore) and checks that each carries the Docker label directory.env=<target> or has <target> in its name.
DB_REMOTE_SSH_HOST=kawlya
DB_REMOTE_PRODUCTION_CONTAINER=
DB_REMOTE_PRODUCTION_WORKER_CONTAINER=
DB_REMOTE_PRODUCTION_WEB_CONTAINER=
DB_REMOTE_DB_NAME=directory
DB_REMOTE_DB_USER=directory
# Shared secret for POST /api/revalidate (worker -> web). At least 32 characters or the endpoint answers 503.
# openssl rand -hex 32
REVALIDATE_SECRET=
# Where the worker reaches the web app (docker/compose.yml: http://web:3000)
INTERNAL_WEB_URL=http://localhost:3000

# AI enrichment (worker only, src/enrich). Unset = enrichment is skipped and plugins stay "Uncategorized".
# Put a key here only for the optional `pnpm payload enrich --mode preview` quality check; tests ignore it.
ANTHROPIC_API_KEY=
# Cost guard: plugins one hourly enrich-all pass may send to the API (default 500).
ENRICH_MAX_PER_PASS=
# Outside NODE_ENV=production the worker sends no (billed) requests unless this is 1.
ENRICH_ALLOW_LOCAL=

# Maintainer sign-in (phase 4). Create a GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# with callback URL ${SERVER_URL}/auth/github/callback (local: http://localhost:3000/auth/github/callback).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Signs the maintainer session cookie (HS256, 30 days). At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
