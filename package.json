{
  "name": "payload-plugins-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "worker": "payload worker --cron \"* * * * *\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "db:pull": "tsx --env-file=.env scripts/db/run.ts pull",
    "db:push": "tsx --env-file=.env scripts/db/run.ts push",
    "enrich:preview": "payload enrich --mode preview",
    "parity": "tsx scripts/parity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@next/env": "^16.4.2",
    "@payloadcms/db-postgres": "4.0.0-beta.3",
    "@payloadcms/next": "4.0.0-beta.3",
    "@payloadcms/plugin-mcp": "4.0.0-beta.3",
    "@payloadcms/plugin-search": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "graphql": "^16.14.2",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "jose": "6.2.12",
    "lucide-react": "^0.563.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-beta.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.34.4",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "3.0.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "16.4.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
